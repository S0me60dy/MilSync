<Window x:Class="MilSync.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MilSync Login" Height="300" Width="400"
        WindowStartupLocation="CenterScreen" Background="#1A1F2E">

    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8B9EC0"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
        </Style>
        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Background"  Value="#252D3D"/>
            <Setter Property="Foreground"  Value="#E0E6F0"/>
            <Setter Property="BorderBrush" Value="#3A4A6B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"     Value="8,6"/>
            <Setter Property="Margin"      Value="0,0,0,12"/>
            <Setter Property="FontSize"    Value="13"/>
        </Style>
        <Style x:Key="PwBox" TargetType="PasswordBox">
            <Setter Property="Background"  Value="#252D3D"/>
            <Setter Property="Foreground"  Value="#E0E6F0"/>
            <Setter Property="BorderBrush" Value="#3A4A6B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"     Value="8,6"/>
            <Setter Property="Margin"      Value="0,0,0,12"/>
            <Setter Property="FontSize"    Value="13"/>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background"  Value="#2563EB"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Padding"     Value="0,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"      Value="Hand"/>
        </Style>
        <Style x:Key="LinkBtn" TargetType="Button">
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="Foreground"  Value="#6B8FD4"/>
            <Setter Property="FontSize"    Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Margin"      Value="0,8,0,0"/>
        </Style>
    </Window.Resources>

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
        <TextBlock Text="ADMIN LOGIN" FontSize="20" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <TextBlock Text="Username" Style="{StaticResource Label}" />
        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" />

        <TextBlock Text="Password" Style="{StaticResource Label}" />
        <PasswordBox Name="passwordBox" Style="{StaticResource PwBox}" />

        <Button Content="Login" Click="OnClickLogin" Height="34" Style="{StaticResource PrimaryBtn}" />
        <Button Content="Forgot password?" Style="{StaticResource LinkBtn}" HorizontalAlignment="Center"/>
    </StackPanel>
</Window>