<Window x:Class="MilSync.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MilSync Login" Height="300" Width="400"
        WindowStartupLocation="CenterScreen" Background="#F0F0F0">
    
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="250">
        <TextBlock Text="ADMIN LOGIN" FontSize="20" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <Label Content="Username" />
        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

        <Label Content="Password" />
        <PasswordBox Name="passwordBox" Margin="0,0,0,20"/>

        <Button Content="Login" Click="OnClickLogin" Height="30" Background="#007ACC" Foreground="White" />
    </StackPanel>
</Window>