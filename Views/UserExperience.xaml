<Window x:Class="MilSync.Views.UserExperience"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MilSync - User Experience" Height="550" Width="800"
        Background="#1A1F2E">
    <Window.Resources>
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="Foreground"       Value="#8B9EC0"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="FontSize"         Value="13"/>
            <Setter Property="Padding"          Value="16,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor"           Value="Hand"/>
        </Style>
        <Style x:Key="ActiveNavBtn" TargetType="Button" BasedOn="{StaticResource NavBtn}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#252D3D"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"     Value="#252D3D"/>
            <Setter Property="CornerRadius"   Value="8"/>
            <Setter Property="Padding"        Value="16"/>
            <Setter Property="Margin"         Value="0,0,0,12"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8B9EC0"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Margin"     Value="0,0,0,3"/>
        </Style>
        <Style x:Key="FieldInput" TargetType="TextBox">
            <Setter Property="Background"      Value="#1A1F2E"/>
            <Setter Property="Foreground"      Value="#E0E6F0"/>
            <Setter Property="BorderBrush"     Value="#3A4A6B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="8,5"/>
            <Setter Property="Margin"          Value="0,0,0,10"/>
            <Setter Property="FontSize"        Value="13"/>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background"      Value="#2563EB"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="Padding"         Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="13"/>
        </Style>
        <Style x:Key="DangerBtn" TargetType="Button">
            <Setter Property="Background"      Value="#7F1D1D"/>
            <Setter Property="Foreground"      Value="#FCA5A5"/>
            <Setter Property="Padding"         Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="13"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="FontSize"    Value="16"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Margin"      Value="0,0,0,12"/>
        </Style>
        <Style x:Key="AppDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowBackground" Value="#FFFFFF"/>
            <Setter Property="AlternatingRowBackground" Value="#F7F9FC"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="RowHeight" Value="34"/>
            <Setter Property="ColumnWidth" Value="*"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="BorderBrush" Value="#E6EDF8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F4F7FB"/>
                        <Setter Property="Foreground" Value="#2B3A4A"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="BorderBrush" Value="#E6EDF8"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="8,4"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#34495E" Padding="15,0">
            <DockPanel VerticalAlignment="Center">
                <TextBlock Text="MilSync User Portal" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button Content="Logout" Click="Logout_Click" DockPanel.Dock="Right" Background="#C0392B" Foreground="White" Padding="10,5" BorderThickness="0" Style="{StaticResource DangerBtn}"/>
                <TextBlock x:Name="WelcomeText" Text="Welcome, User" Foreground="#BDC3C7" HorizontalAlignment="Right" Margin="0,0,20,0" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="10" Background="Transparent" BorderThickness="0">
            <TabItem Header="My Records">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Background="White">
                        <Ellipse Width="100" Height="100" Fill="#BDC3C7" Margin="0,0,0,15"/>
                        <TextBlock x:Name="ProfileUsername" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="ProfileRole" Foreground="Gray" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                        <Separator/>
                        <TextBlock Text="Email:" FontWeight="Bold" Margin="0,10,0,0"/>
                        <TextBlock x:Name="ProfileEmail" TextWrapping="Wrap"/>
                        <TextBlock Text="Rank:" FontWeight="Bold" Margin="0,10,0,0"/>
                        <TextBlock x:Name="ProfileRank"/>
					</StackPanel>

                    <Border Grid.Column="1" Margin="10,0,0,0" Background="White" Padding="15">
                        <StackPanel>
                            <TextBlock Text="Medical &amp; Military History" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                            <TextBlock Text="Confidential records are displayed below." Foreground="DimGray" FontStyle="Italic" Margin="0,0,0,10"/>
                            <ScrollViewer Height="250">
                                <TextBlock x:Name="RecordsContent" Text="No records found." TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Browse Jobs" Margin="-2,-2,-2,2">
                <Grid Margin="10" Background="White">
                    <StackPanel Margin="15">
                        <TextBlock Text="Available Career Paths" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                        <DataGrid x:Name="JobsGrid" Height="300" SelectionChanged="JobsGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
                                <DataGridTextColumn Header="Requirement" Binding="{Binding Requirements}" Width="*"/>
                                <DataGridTemplateColumn Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Apply" Click="Apply_Click" Background="#27AE60" Foreground="White" BorderThickness="0" Style="{StaticResource GreenBtn}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="My Applications" Height="22" Margin="3,0,-7,4" VerticalAlignment="Bottom">
                <Grid Margin="10" Background="White">
                    <StackPanel Margin="15">
                        <TextBlock Text="My Applications" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                        <DataGrid x:Name="ApplicationsGrid" Style="{StaticResource AppDataGrid}" Height="300">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Job Title" Binding="{Binding JobTitle}" Width="*"/>
                                <DataGridTextColumn Header="Submitted" Binding="{Binding SubmissionDate}" Width="150"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>