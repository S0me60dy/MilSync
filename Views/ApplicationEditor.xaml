<Window x:Class="MilSync.Views.ApplicationEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Application Editor" Height="300" Width="400">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="User ID"/>
            <TextBox Text="{Binding UserID, Mode=TwoWay}" />
            <TextBlock Text="Job ID" Margin="0,8,0,0"/>
            <TextBox Text="{Binding JobID, Mode=TwoWay}" />
            <TextBlock Text="Submission Date" Margin="0,8,0,0"/>
            <DatePicker SelectedDate="{Binding SubmissionDate, Mode=TwoWay}" />
            <TextBlock Text="Status" Margin="0,8,0,0"/>
            <ComboBox SelectedItem="{Binding Status, Mode=TwoWay}">
                <ComboBoxItem Content="Pending" />
                <ComboBoxItem Content="Approved" />
                <ComboBoxItem Content="Rejected" />
            </ComboBox>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Width="80" Margin="0,0,10,0" IsDefault="True" Click="Ok_Click"/>
            <Button Content="Cancel" Width="80" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>