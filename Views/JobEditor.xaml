<Window x:Class="MilSync.Views.JobEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Job Editor" Height="350" Width="500">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Title"/>
            <TextBox Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="Description" Margin="0,8,0,0"/>
            <TextBox Text="{Binding Description, Mode=TwoWay}" AcceptsReturn="True" Height="80"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <StackPanel Width="240">
                    <TextBlock Text="Location"/>
                    <TextBox Text="{Binding Location, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Margin="10,0,0,0" Width="120">
                    <TextBlock Text="Salary"/>
                    <TextBox Text="{Binding Salary, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Margin="10,0,0,0" Width="120">
                    <TextBlock Text="Required Rank"/>
                    <TextBox Text="{Binding RequiredRank, Mode=TwoWay}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Width="80" Margin="0,0,10,0" IsDefault="True" Click="Ok_Click"/>
            <Button Content="Cancel" Width="80" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>