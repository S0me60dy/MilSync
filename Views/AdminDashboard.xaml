<Window x:Class="MilSync.Views.AdminDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MilSync - Admin Dashboard" Height="600" Width="900"
        Background="#F4F4F4">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/> <ColumnDefinition Width="*"/>   </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="#2C3E50">
            <TextBlock Text="ADMIN PANEL" Foreground="White" Margin="20" FontWeight="Bold" FontSize="18"/>
            <Button Content="Manage Personnel" Margin="10" Padding="5" Background="Transparent" Foreground="White" BorderThickness="0"/>
            <Button Content="Audit Logs" Margin="10" Padding="5" Background="Transparent" Foreground="White" BorderThickness="0"/>
            <Button Content="Job Postings" Margin="10" Padding="5" Background="Transparent" Foreground="White" BorderThickness="0"/>
            <Separator Margin="10" Background="#34495E"/>
            <Button Content="Logout" Click="Logout_Click" Margin="10" Padding="5" Background="#E74C3C" Foreground="White"/>
        </StackPanel>

        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <RowDefinition Height="*"/>    </Grid.RowDefinitions>

            <TextBlock Text="Personnel Management" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

            <DataGrid x:Name="UsersDataGrid" Grid.Row="1" AutoGenerateColumns="False" 
                      CanUserAddRows="False" Background="White" BorderBrush="#DDDDDD">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding UserID}" Width="50"/>
                    <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="*"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                    <DataGridTextColumn Header="Rank" Binding="{Binding Rank}" Width="100"/>
                    <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="100"/>
                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="60"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Window>